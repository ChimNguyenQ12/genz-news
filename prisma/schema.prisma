// Cơ sở dữ liệu GenZ News — SQLite, một tệp nằm trong thư mục data.
//
// Vì sao SQLite: trang tin một máy chủ, lượng ghi thấp (chỉ biên tập viên ghi,
// độc giả chỉ đọc), dữ liệu vài nghìn bản ghi. SQLite bỏ hẳn một container,
// một tiến trình và một chuỗi kết nối; sao lưu là copy một tệp.
//
// Lưu ý SQLite không có kiểu mảng và enum, nên:
//   - các trường danh sách lưu chuỗi JSON, quy đổi ở lib/store.ts
//   - enum lưu chuỗi, chặn giá trị sai ở tầng API

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String
  passwordHash String
  salt         String
  /// "admin" | "contributor"
  role         String   @default("contributor")
  /// Khoá bởi admin (/admin/users): không đăng nhập được, phiên đang mở mất
  /// hiệu lực ngay. NULL = đang hoạt động.
  disabledAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  articles Article[]
  comments Comment[]

  @@map("users")
}

model Article {
  id    String @id @default(uuid())
  slug  String @unique
  title String
  dek   String @default("")

  category String
  /// "draft" | "pending" | "published" | "rejected"
  status String @default("draft")
  /// "vi" | "en" — ngôn ngữ gốc, quyết định chiều dịch
  language String @default("vi")

  /// Nội dung HTML đã làm sạch trước khi lưu.
  body String @default("")

  /// Mảng JSON: ["AI","Việc làm"]
  tags   String @default("[]")
  author String

  authorId String?
  user     User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  /// Mảng JSON 2 phần tử: ["#7C3AED","#22D3EE"]
  coverGradient     String  @default("[\"#7C3AED\",\"#22D3EE\"]")
  coverImage        String?
  coverImageCaption String?

  publishedAt    String
  readingTimeMin Int     @default(3)
  featured       Boolean @default(false)
  trending       Boolean @default(false)

  submittedAt DateTime?
  reviewNote  String?

  sources      Source[]
  comments     Comment[]
  socialPosts  SocialPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([category, status])
  @@index([authorId])
  @@map("articles")
}

model Source {
  id   String @id @default(uuid())
  name String
  url  String

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  /// Giữ đúng thứ tự nguồn như biên tập viên nhập.
  position Int @default(0)

  @@index([articleId])
  @@map("sources")
}

/// Bình luận. Trả lời chỉ 1 tầng: reply luôn trỏ về comment gốc.
model Comment {
  id   String @id @default(uuid())
  body String

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// null = bình luận gốc; có giá trị = trả lời cho bình luận gốc đó.
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model ResearchRequest {
  id    String @id @default(uuid())
  topic String
  /// Tít dịch sang tiếng Việt, do scripts/translate-topics.mjs điền. NULL khi
  /// chưa dịch — màn hình khi đó hiện tít gốc.
  topicVi String?
  /// Mảng JSON các link gợi ý.
  urls  String @default("[]")
  notes String @default("")
  /// "pending" | "in_progress" | "done" | "rejected"
  status       String  @default("pending")
  reporterNote String?
  /// Mảng JSON id các bài đã tạo từ đề tài này.
  articleIds String @default("[]")

  /// Thời điểm giao việc cho máy viết ở lượt gần nhất. Dùng để hiển thị tiến
  /// độ ở tab "Đang viết" và để phát hiện lượt treo (giao lâu mà không xong).
  assignedAt DateTime?
  /// Số lần đã giao. attempts > 0 mà status = 'pending' nghĩa là lượt trước
  /// hỏng và đề tài đã được trả về hàng đợi — khác hẳn đề tài chưa ai đụng tới.
  attempts Int @default(0)
  /// Vì sao lượt gần nhất hỏng. Rỗng nếu chưa từng hỏng.
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([assignedAt])
  @@map("research_requests")
}

/// Một bài viết trên web ↔ một bài trên một mạng xã hội (Facebook Page, Threads).
///
/// Vòng đời: scheduled → publishing → published, hoặc → failed (kèm lastError,
/// sửa rồi lên lịch lại). "publishing" là khoá tạm: lượt chạy nào đổi được
/// scheduled → publishing thì lượt đó đăng, nên hai lượt chồng nhau không đăng
/// trùng một bài.
model SocialPost {
  id              String    @id @default(uuid())
  articleId       String
  article         Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  /// "facebook" | "threads"
  platform        String
  status          String    @default("scheduled")
  caption         String
  comment         String
  /// Thẻ chủ đề Threads (gửi qua tham số topic_tag, mỗi bài một thẻ). Nền tảng khác bỏ qua.
  topicTag        String?
  scheduledAt     DateTime?
  /// id bài trên nền tảng (Facebook: pageId_postId; Threads: media id)
  remotePostId    String?
  /// Facebook: id tấm ảnh — có thao tác chỉ làm được qua id này
  remoteMediaId   String?
  /// bình luận / reply đầu tiên chứa link bài
  remoteCommentId String?
  permalink       String?
  postedAt        DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([articleId, platform])
  @@index([platform, status, scheduledAt])
  @@map("social_posts")
}
