// Schema cơ sở dữ liệu cho GenZ Now.
// Đổi provider sang "mysql" / "sqlite" nếu cần — phần code truy vấn giữ nguyên.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  contributor
}

enum ArticleStatus {
  draft
  pending
  published
  rejected
}

enum RequestStatus {
  pending
  in_progress
  done
  rejected
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String
  passwordHash String
  salt         String
  role         Role     @default(contributor)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  articles Article[]
  comments Comment[]

  @@map("users")
}

model Article {
  slug  String @unique
  title String
  dek   String @default("")

  id       String        @id @default(uuid())
  category String
  status   ArticleStatus @default(draft)

  /// Ngôn ngữ gốc của bài: "vi" hoặc "en". Dùng để biết dịch theo chiều nào.
  language String @default("vi")

  /// Nội dung HTML đã được làm sạch trước khi lưu.
  body String @default("")

  tags   String[] @default([])
  author String

  authorId String?
  user     User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  coverGradient     String[] @default(["#7C3AED", "#22D3EE"])
  coverImage        String?
  coverImageCaption String?

  publishedAt    String
  readingTimeMin Int     @default(3)
  featured       Boolean @default(false)
  trending       Boolean @default(false)

  submittedAt DateTime?
  reviewNote  String?

  sources  Source[]
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([category, status])
  @@index([authorId])
  @@map("articles")
}

model Source {
  id   String @id @default(uuid())
  name String
  url  String

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  /// Giữ đúng thứ tự nguồn như biên tập viên nhập.
  position Int @default(0)

  @@index([articleId])
  @@map("sources")
}

/// Bình luận. Chỉ cho trả lời 1 tầng: reply luôn trỏ về comment gốc,
/// không có reply-của-reply (ràng buộc này được kiểm ở tầng API).
model Comment {
  id   String @id @default(uuid())
  body String

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// null = bình luận gốc; có giá trị = trả lời cho bình luận gốc đó.
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model ResearchRequest {
  id           String        @id @default(uuid())
  topic        String
  urls         String[]      @default([])
  notes        String        @default("")
  status       RequestStatus @default(pending)
  reporterNote String?
  articleIds   String[]      @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("research_requests")
}
