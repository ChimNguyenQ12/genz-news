// Cơ sở dữ liệu GenZ News — SQLite, một tệp nằm trong thư mục data.
//
// Vì sao SQLite: trang tin một máy chủ, lượng ghi thấp (chỉ biên tập viên ghi,
// độc giả chỉ đọc), dữ liệu vài nghìn bản ghi. SQLite bỏ hẳn một container,
// một tiến trình và một chuỗi kết nối; sao lưu là copy một tệp.
//
// Lưu ý SQLite không có kiểu mảng và enum, nên:
//   - các trường danh sách lưu chuỗi JSON, quy đổi ở lib/store.ts
//   - enum lưu chuỗi, chặn giá trị sai ở tầng API

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String
  passwordHash String
  salt         String
  /// "admin" | "contributor"
  role         String   @default("contributor")
  /// Khoá bởi admin (/admin/users): không đăng nhập được, phiên đang mở mất
  /// hiệu lực ngay. NULL = đang hoạt động.
  disabledAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  articles Article[]
  comments Comment[]

  @@map("users")
}

model Article {
  id    String @id @default(uuid())
  slug  String @unique
  title String
  dek   String @default("")

  /// Chuyên mục CHÍNH: quyết định màu nhãn, breadcrumb và chỗ bài nằm trong
  /// bài liên quan.
  category String
  /// Mảng JSON các chuyên mục PHỤ, VD ["kinh-doanh","cong-nghe"]. Bài hiện ở
  /// trang /chuyen-muc của cả chuyên mục chính lẫn mọi chuyên mục phụ. Không
  /// bao giờ chứa lại chuyên mục chính (API tự lọc).
  extraCategories String @default("[]")
  /// "draft" | "pending" | "published" | "rejected"
  status String @default("draft")
  /// "vi" | "en" — ngôn ngữ gốc, quyết định chiều dịch
  language String @default("vi")

  /// Nội dung HTML đã làm sạch trước khi lưu.
  body String @default("")

  /// Mảng JSON: ["AI","Việc làm"]
  tags   String @default("[]")
  author String

  authorId String?
  user     User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  /// Mảng JSON 2 phần tử: ["#7C3AED","#22D3EE"]
  coverGradient     String  @default("[\"#7C3AED\",\"#22D3EE\"]")
  coverImage        String?
  /// Mô tả ngắn, THUẦN VĂN BẢN (không HTML) — hiện ngay dưới ảnh bìa.
  coverImageCaption String?
  /// JSON ImageCredit — ghi công + link "(nguồn)" thật, hiện cạnh caption.
  /// Tách khỏi coverImageCaption để "(nguồn)" luôn là link render đúng, không
  /// phải chuỗi HTML nhét vào một trường thuần văn bản (rò rỉ thẻ ra mặt chữ).
  coverImageCredit  String?

  publishedAt    String
  readingTimeMin Int     @default(3)
  featured       Boolean @default(false)
  trending       Boolean @default(false)
  /// Vị trí trong slideshow hero trang chủ (1 = đầu tiên); NULL = không hiện. featured = featuredOrder != NULL.
  featuredOrder  Int?
  /// Vị trí trong khối "Đang nóng" (1 = trên cùng); NULL = không hiện.
  trendingOrder  Int?

  /// Vị trí trong khối "Tin Nóng" ở cột chính trang chủ (1 = trên cùng);
  /// NULL = không hiện. Thay cho danh sách "Mới nhất" tự động trước đây.
  hotOrder       Int?

  /// Lượt đánh giá của người đọc ("bài này hữu ích không"). Cộng dồn đơn giản,
  /// KHÔNG gắn với tài khoản vì khách chưa đăng nhập vẫn bấm được — xem
  /// app/api/articles/[id]/react/route.ts. Vì vậy con số này là thăm dò ý kiến,
  /// không phải dữ liệu chính xác: chống bấm lặp chỉ nằm ở phía trình duyệt.
  likeCount    Int @default(0)
  dislikeCount Int @default(0)

  /// Lượt đọc, cộng dồn. Đếm bằng beacon phía trình duyệt (trang bài là ISR nên
  /// máy chủ không thấy từng lượt tải) — xem lib/views.ts. Cũng như like, KHÔNG
  /// ghi ai đọc: chỉ một con số trên bài, cộng theo lô để không ghi đĩa mỗi lượt.
  viewCount    Int @default(0)

  submittedAt DateTime?
  reviewNote  String?

  sources      Source[]
  comments     Comment[]
  socialPosts  SocialPost[]
  viewDays     ArticleViewDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([category, status])
  @@index([authorId])
  @@map("articles")
}

model Source {
  id   String @id @default(uuid())
  name String
  url  String

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  /// Giữ đúng thứ tự nguồn như biên tập viên nhập.
  position Int @default(0)

  @@index([articleId])
  @@map("sources")
}

/// Bình luận. Trả lời chỉ 1 tầng: reply luôn trỏ về comment gốc.
model Comment {
  id   String @id @default(uuid())
  /// Có thể rỗng nếu bình luận chỉ có ảnh/video (mediaUrl khi đó bắt buộc).
  body String

  /// "image" | "video" | NULL (không đính kèm). mediaUrl luôn nằm trên kho S3
  /// của mình (đã qua /api/upload) — không nhận URL ngoài.
  mediaType String?
  mediaUrl  String?

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  /// NULL = bình luận ẩn danh của khách chưa đăng nhập (khi đó authorName bắt buộc).
  /// Khách vẫn bấm được nhưng không xoá lại được bình luận của mình, vì không có
  /// gì để đối chiếu danh tính — chỉ admin xoá được.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Tên hiển thị của khách ẩn danh. NULL khi bình luận bằng tài khoản (lúc đó
  /// lấy user.displayName). Không gộp vào một cột chung vì khách đổi nick được
  /// mỗi lần bình luận, còn tên tài khoản thì không.
  authorName String?

  /// null = bình luận gốc; có giá trị = trả lời cho bình luận gốc đó.
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model ResearchRequest {
  id    String @id @default(uuid())
  topic String
  /// Tít dịch sang tiếng Việt, do scripts/translate-topics.mjs điền. NULL khi
  /// chưa dịch — màn hình khi đó hiện tít gốc.
  topicVi String?
  /// Mảng JSON các link gợi ý.
  urls  String @default("[]")
  notes String @default("")
  /// "pending" | "in_progress" | "done" | "rejected"
  status       String  @default("pending")
  reporterNote String?
  /// Mảng JSON id các bài đã tạo từ đề tài này.
  articleIds String @default("[]")

  /// Thời điểm giao việc cho máy viết ở lượt gần nhất. Dùng để hiển thị tiến
  /// độ ở tab "Đang viết" và để phát hiện lượt treo (giao lâu mà không xong).
  assignedAt DateTime?
  /// Số lần đã giao. attempts > 0 mà status = 'pending' nghĩa là lượt trước
  /// hỏng và đề tài đã được trả về hàng đợi — khác hẳn đề tài chưa ai đụng tới.
  attempts Int @default(0)
  /// Vì sao lượt gần nhất hỏng. Rỗng nếu chưa từng hỏng.
  lastError String?
  /// Nguồn sinh ra đề tài: "threads" = đã đo độ bàn tán trên Threads (mục
  /// Threads ở /admin/research); NULL = nhập tay hoặc các nguồn thường.
  source String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([assignedAt])
  @@index([source, createdAt])
  @@map("research_requests")
}

/// Một bài viết trên web ↔ một bài trên một mạng xã hội (Facebook Page, Threads).
///
/// Vòng đời: scheduled → publishing → published, hoặc → failed (kèm lastError,
/// sửa rồi lên lịch lại). "publishing" là khoá tạm: lượt chạy nào đổi được
/// scheduled → publishing thì lượt đó đăng, nên hai lượt chồng nhau không đăng
/// trùng một bài.
model SocialPost {
  id              String    @id @default(uuid())
  articleId       String
  article         Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  /// "facebook" | "threads"
  platform        String
  status          String    @default("scheduled")
  caption         String
  comment         String
  /// Thẻ chủ đề Threads (gửi qua tham số topic_tag, mỗi bài một thẻ). Nền tảng khác bỏ qua.
  topicTag        String?
  /// Media đăng kèm, JSON [{type:"image"|"video", url}]. NULL = dùng ảnh bìa của
  /// bài (mặc định); "[]" = chỉ đăng chữ. URL phải nằm trên kho S3 của mình.
  media           String?
  scheduledAt     DateTime?
  /// id bài trên nền tảng (Facebook: pageId_postId; Threads: media id)
  remotePostId    String?
  /// Facebook: id tấm ảnh — có thao tác chỉ làm được qua id này
  remoteMediaId   String?
  /// bình luận / reply đầu tiên chứa link bài
  remoteCommentId String?
  permalink       String?
  postedAt        DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([articleId, platform])
  @@index([platform, status, scheduledAt])
  @@map("social_posts")
}

/// Lượt đọc theo ngày (giờ Việt Nam) — để biết bài nào đang được đọc HÔM NAY,
/// điều mà tổng viewCount không cho thấy. Chỉ là con số, không gắn người đọc.
model ArticleViewDay {
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  /// "YYYY-MM-DD" theo giờ Việt Nam
  day       String
  views     Int     @default(0)

  @@id([articleId, day])
  @@index([day])
  @@map("article_view_days")
}

/// Thông báo cho khu quản trị: tài khoản mới, bài đổi trạng thái, bình luận
/// mới, mốc lượt đọc, cảnh báo lưu lượng bất thường. Chỉ admin đọc được.
///
/// Trạng thái đã đọc dùng chung cho mọi admin (trang chỉ có một tổng biên tập).
/// KHÔNG ghi địa chỉ IP vào đây — trang Quyền riêng tư cam kết IP chỉ nằm tạm
/// trong bộ nhớ; IP cụ thể chỉ xem trực tiếp ở tab Traffic.
model AdminNotification {
  id        String    @id @default(uuid())
  /// "user" | "article" | "comment" | "views" | "traffic" | "system"
  type      String
  /// "info" | "warning" | "danger"
  level     String    @default("info")
  title     String
  body      String    @default("")
  /// Đường dẫn nội bộ để bấm vào, VD /admin/articles/<id>
  link      String?
  articleId String?
  /// Gộp sự kiện lặp: còn một thông báo CHƯA ĐỌC cùng groupKey gần đây thì
  /// cộng count vào đó thay vì tạo dòng mới (VD 30 bình luận trên một bài).
  groupKey  String?
  count     Int       @default(1)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([createdAt])
  @@index([readAt, createdAt])
  @@index([groupKey])
  @@map("admin_notifications")
}
