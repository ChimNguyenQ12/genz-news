# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Dữ liệu chạy thật: SQLite, khoá phiên, dữ liệu thô. Trên máy chủ thư mục này
