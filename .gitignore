# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dữ liệu chạy thật — nội dung nay nằm trong PostgreSQL
/data/trends-digest.json
# file JSON cũ trước khi chuyển sang DB (chứa hash mật khẩu) — không commit
/data/legacy-json/

# file người dùng tải lên
/public/uploads/
